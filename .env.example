# ===================================================
# WorkSphere Master Environment Configuration Template
# (Do not commit sensitive production credentials)
# ===================================================

# Server Environment
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worksphere?schema=public

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Caching & BullMQ Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# FastAPI Analytics Service Communication
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_API_KEY=worksphere_internal_analytics_api_secret_key

# Third-Party Integrations (Sandbox Defaults)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
FROM_EMAIL=notifications@worksphere.io

# Object Storage (S3 / MinIO Compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=worksphere-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
